 "poems": [
  {
   "seq": "1",
   "text": "秋ことに草のかつらの折ぬるもあわれいくよの霜の松かえ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "くち残る苔の埋れ木あはれ又いつをしのふの草と生けん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄苔雑",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "あらにちる露ともいかていはし水結ふ手とに千世を駕へて",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄水雑",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "きのふまて雪にみなれし山の端も霞に明て春やたつらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立春",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "いつくそと四方の梢もしら衣のたぎかさなれかあさ霞かな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝霞",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "谷の戸を都に出るらくひすの声にも春の色やそふらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "谷鶯",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "さえかへり風にや来るやまかけはつれなく残るこその白",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残雪",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "一朝霜もまた消あへぬ春の野のわかなつみにと誰いそくらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若菜",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "日にそへてなを咲こるや梅かえのにほひにふかき春の山里",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里梅",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "春風に軒端の梅やささふらんしはしはにほふこしてねの夢",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "喰梅",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "所からかはるともなし春の夜はあかしのうらも雲な月かけ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "たくひなき名にたつ春の浦や波間もかすむ住よしの浜",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春暁",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "かりかねの帰るさいそく越路には都にまさる花や咲らん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰丁",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "降つゝきはれ間もなくて水日になをくれやらぬ春雨の比",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "さほ姫の春のすかたかかはきしにしたり桜の玉かつらして",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岸柳",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "木のほに待えつれなき心哉器のした紐とせぬ日数は",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "侍花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "かつ咲し桜か枝や見るかこちになをかすまさる花の色哉",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "行人にぬきをくれてんけるもまたみやまされらの春の夕暮",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見花",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "梢まてされも残らぬ花の枝にふくとも風の心あらなん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花盛",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "よし野山いつはありとも朝ほらけはなのし雪地りつもる比",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "春深きうちの河嶋やく行におもかけひた吹きしの山吹",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "池ひろく吹たつ風もをのつから松のしつ枝にかゝる宮波",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池藤",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "越きつる道もかはらてかへるさき東の関も春やゆうらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "一花染の春の衣をぬきかへしたとよりけふ夏はきぬらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "更衣",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "たの夜も月にやまかふみちのくのまかきの嶋にさける外花",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "初色をまつ地の山のほとゝきすきつゝても人にかゝらんなおし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "侍郭公",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "ほとゝきす磯のをたまきいかに遣はくりかへしなく声に吹なん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "一一ゑを名残になして横空にあかてわかるゝ山ほとも",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公稀",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ふることはすむ人もなし袖の山を花たちはれに誰残さまし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古郷橋",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "うらわかきはなへの末葉打なひきとるねにいそけ当の夕暮",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "さみたつれに瀬堂へし川も渕なれや舟よはひする水の行末",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "一月影に鵜舟の篝の篝きゝて波間こき出る夕くれのそら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜川",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一しけりそふ草の葉かくれ飛ほたる露にひかりの見たれて其行",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "義蛍",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "籬より咲こほれてや白露もをき所なきなてしこのはな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "山のはにいゆるものも程になくはや明かたの空の月影",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "なる神のたゝ一とをり一里の風も涼しき夕立のあと",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "夏の日のこゑのうちにや磯暮せみのはらすき衣ねの杜",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜憚",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "河水に七瀬よりくる六月のめくみあまたのぬさの追風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏祓",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "いつれにかさためて聞ん今日よりの草木からへの秋の大風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "せめてさは夜を長月にちき体かしほとなくあくるほしあひの左",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "萩の風枕にちかし音つれてなを称覚する秋の夜半かな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "荻風",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "しり露ににしまの紐をとく花のみたれて匂ふ力野ゝむら藤の",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花露",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "あたし野のあたなる露の秋の色に風のまゝなるをみなへし哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "女郎花",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "色かはる風もあらしのあまちふにむしの音しける秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕虫",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "さしのほる月もくまなき余の野をおのかたちとゝ鹿や鳴らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜鹿",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "海山や越路ほとなき空の雲いく行すきぬ初かりの声",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初雁",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "それとなくすゝろに物のかなしきは色かは行秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "種タ",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "源にけり山のはつかに影そひて雲をはよそに月や出ぬらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "しはし肝心して吹月屋はる露はこほさし野への秋風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野月",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "くもりなくてりそふ月のかつら川名になかれたる影のさやけさ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "同月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "長本の有明まてもありさりし名残を今やみしま江の月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "暮かゝる波より月や出ぬらん底もくもくもらぬ秋のうなはら",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦月",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "咲あまるまかきの菊の花のうへににあひとあるゝ秋の白露",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑菊",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "きぬたうつぬしはたれとも知ねとも自に寐覚のなとならか",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "きりふかき淀の川瀬の明ほのや春のかすみもおもひいつらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁霧",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "露時雨染をくかたやまさる経ん夕日色こきをかのもみちは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岡紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "いかか一木かうへも残り残りなりなうつろいかはる軒のもみちは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "おしみてもなにかは一あしならぬこまひはかりの秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月尽",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "花にみし千草もさびしかれて行野へのけしきに冬は来にけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "秋にやはかはらぬ雲の夕しくれさすかに空の冬こもりして",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "もみちはのみなちりはてゝ後にさへ又木のもとにいとふ山かせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "いとふかくをくとはすれと胡霜の廣か日かけに消はのこらし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝霜",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "庭の面に残るさひしへ冬草のかれたにはてぬ影のさむけさ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "沖津風塩みちくるやむらちとりた地さわく声の浦つたひ行",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "うきねしてつかはぬ鷺のおもひよりとものしそひとりさへぬる",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "山おろしはけしく吹て谷つも氷にむせぬ水のしらなみ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "氷始結",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "ける雪の空にばくれて冬の本の月のひかりやつもりそふらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "かり人のたゝ地落草分ゆらて行末もしらす野へにくらしつ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "分て行袖にたまらぬ玉あらき松地ても野人の草はにやちる",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野霰",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "都にはあさきといはん程もなし深山のおくの雪のこゝろを",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残野",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "山よりもなを山たかし降かくす松のこするやみ手のしら雪",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "積雪",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "友をまつ雪をは雪も思ふらんふらんふりぬるやこふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閏中野",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "花の春月の秋にそめくりあはんくれ行年のおしきものかう",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "なかむれば猶うき事やまさるらん袖のならたにやとる自影",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "晴間なくそなたの空もかゝならん空にみたれて物思ころ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雲恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "思ひあまる袖のなみたをきみかあたりみつゝ草葉の露と置て",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄露恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "待わひし心もしらて夕く袴の弟々かきくもり両になり行",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雨応",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "身にそしむこひのつ方なる賤命の堂よりに散し言の声の末",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄風恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "時雨してうほろひやせん緑の丞も吉葉の山も人のこゝろも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄山応",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "いかにしてしける人めの世のつからしのふる中に関と成らん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄関恋",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "物おもふ袖の中にも海はあれと見るめ給へきにたにもなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄海恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "袖の上の涙とはるあま地はら露をきそふる夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄原恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "さめてこそ猶恋わたれ逢逢美ても末たへぬへき夢のうさはし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄橘恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "やとり木のねもみぬ物のかりそめもちきりとならは無名堂にたて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "いかにせんいそかくれかくもしほ草よりくる波にもれてみえなは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "有明の月にうかれてはつ鳥裳ましきになくや衣〳〵の空",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥恋",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "しるやいかにもにすむ虫にあらねともいれからぬるゝわか袂かけ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄虫恋",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "中々に侍人もなき夕くれはやすくふすゐの床のひとりね",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄獣恋",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "ほらかりしことのはことに消ゆらてなみたの露や玉とちならん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄玉恋",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "うき人の心のうらはみてもうしかけも見なれぬかゝみなりとも",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鏡恋",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "みとせせはまちわひぬとも新枕又いまさらにいかてさためむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄枕恋",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "く地まさる袖や忍ふのすり衣かきてもしらぬ露のみたれに",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄衣恋",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "こひ路よりまつみたれたる心かと糸にはあらぬ我身なれとも",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄糸恋",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "浦とをく塩やみつらん波間より猪すくなき松のむら〳〵",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦松",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "さむしさの友とやならん鹿覚する枕にさやくまとのくれ候竹",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "窓竹",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "山人の薪こりつゝかへるけを嵐そをくる夕くれのそら",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家嵐",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "秋の田の色つらひのかり庵をしつか家に住やなすらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "忘るなよみしにもあらぬ古郷もかはらぬ友は月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古郷",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "一とまりせはいつくともなく舟への風にまかせてなと地行らん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "たひころもたちし都をへしてつゝ峯こえてまし空かさなる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇旅",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "うき世とて堂体をおこたん我さへやことろのまゝにあらぬ身なれは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "きみか代は千と世をかけて松の尾の神のめくみも猶やそふらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祇",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "なにの道もまさきのかつら末つひにたへ吹つたへと家々の風",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733155",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝言",
   "kotobagaki": ""
  }
 ],
